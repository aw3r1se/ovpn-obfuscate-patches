+#if OBFS_ENABLE_WSS
+static bool
+sockets_wss_wants_write(const struct context *c)
+{
+    for (int i = 0; i < c->c1.link_sockets_num; ++i)
+    {
+        const struct link_socket *sock = c->c2.link_sockets[i];
+        if (sock && sock->wss && obfs_wss_wants_write(sock))
+        {
+            return true;
+        }
