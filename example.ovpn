# Copy this file to client.ovpn and uncomment exactly ONE connection block.
# Replace its endpoint and keys with values for that server and mode.
# All connection blocks below are disabled until you select one.
# Relative file paths resolve from the directory passed to --cd.

client
dev tap
ca certs/ca.crt
cert certs/client.crt
key certs/client.key
remote-cert-tls server
auth-nocache
nobind
persist-key
persist-tun
disable-dco
verb 3

# Keep the device type and any required compression options from your profile.
# Windows TAP needs a TAP-Windows adapter. macOS native utun needs a TUN profile;
# changing dev alone does not convert a TAP server to TUN.
# comp-lzo

# 1. TCP + tls-crypt-v2 (stock OpenVPN; no patches required)
# proto tcp-client
# remote vpn.example.invalid 443
# tls-crypt-v2 tls-crypt-v2-client.key

# 2. TCP Scrambler (general + tcp)
# proto tcp-client
# remote vpn.example.invalid 443
# obfuscate TCP_KEY

# 3. TCP Scrambler + tls-crypt (general + tcp)
# proto tcp-client
# remote vpn.example.invalid 443
# obfuscate TCP_KEY
# tls-crypt tls-crypt.key

# 4. TCP over WSS (general + wss)
# proto tcp-client
# remote vpn.example.invalid 443
# wss-proxy front.example.invalid /provider-path

# 5. TCP over WSS + tls-crypt (general + wss)
# proto tcp-client
# remote vpn.example.invalid 443
# wss-proxy front.example.invalid /provider-path
# tls-crypt tls-crypt.key

# 6. TCP over WSS + tls-crypt-v2 (general + wss)
# proto tcp-client
# remote vpn.example.invalid 443
# wss-proxy front.example.invalid /provider-path
# tls-crypt-v2 tls-crypt-v2-client.key

# 7. TCP Scrambler over WSS (general + tcp + wss)
# proto tcp-client
# remote vpn.example.invalid 443
# obfuscate TCP_KEY
# wss-proxy front.example.invalid /provider-path

# 8. UDP + tls-crypt-v2 (stock OpenVPN; no patches required)
# proto udp
# remote vpn.example.invalid 1194
# tls-crypt-v2 tls-crypt-v2-client.key

# 9. UDP obfuscation (general + udp)
# proto udp
# remote vpn.example.invalid 1194
# obfuscate-udp UDP_HEX_KEY MAX_PADDING_BYTES

# 10. UDP obfuscation + tls-crypt (general + udp)
# proto udp
# remote vpn.example.invalid 1194
# obfuscate-udp UDP_HEX_KEY MAX_PADDING_BYTES
# tls-crypt tls-crypt.key

# 11. UDP obfuscation + tls-crypt-v2 (general + udp)
# proto udp
# remote vpn.example.invalid 1194
# obfuscate-udp UDP_HEX_KEY MAX_PADDING_BYTES
# tls-crypt-v2 tls-crypt-v2-client.key

# TCP_KEY is the exact text key issued for TCP Scrambler.
# UDP_HEX_KEY is a 128-character hexadecimal key (64 bytes).
# MAX_PADDING_BYTES is an integer from 0 to 1500, for example 32 or 64.
# It limits additional padding; obfuscated UDP datagrams cannot exceed 1472 bytes.
# Encoded packets need at least 32 bytes; too little padding rejects short packets.

# Optional WSS settings: use only with a WSS connection block.
# remote selects the TCP endpoint; wss-proxy supplies the HTTP Host and URI.
# Enable SNI or custom HTTP headers if required by the server.
# Outer TLS verifies the SNI name when supplied, otherwise the HTTP Host.
# wss-proxy-sni front.example.invalid
# wss-proxy-header X-Custom-Header "REPLACE_WITH_PROVIDER_VALUE"
# The following option disables OUTER TLS certificate verification.
# wss-proxy-allow-self-signed-cert

# Inline tls-crypt-v2 alternative: leave the file directive commented and
# uncomment every line of this block. Replace the placeholder with the complete
# provider-issued client key body, keeping the BEGIN/END lines unchanged.
# Do not combine tls-crypt-v2 with tls-auth or tls-crypt in a client profile.
# <tls-crypt-v2>
# -----BEGIN OpenVPN tls-crypt-v2 client key-----
# BASE64_CLIENT_KEY_DATA
# -----END OpenVPN tls-crypt-v2 client key-----
# </tls-crypt-v2>

# Inline tls-crypt alternative: leave the file directive commented and copy
# the provider's complete static key body between these BEGIN/END lines.
# <tls-crypt>
# -----BEGIN OpenVPN Static key V1-----
# STATIC_KEY_HEX_DATA
# -----END OpenVPN Static key V1-----
# </tls-crypt>

# Data cipher: keep the provider's negotiation settings or select ONE line.
# Leave these commented to use OpenVPN's default cipher list.
# data-ciphers AES-256-GCM
# data-ciphers AES-128-GCM
# data-ciphers AES-256-CBC
# data-ciphers AES-128-CBC
# data-ciphers BF-CBC

# BF-CBC also requires the matching OpenSSL legacy provider; see README.
# providers legacy default
# For servers without cipher negotiation, set fallback to the selected cipher.
# data-ciphers-fallback AES-128-CBC
